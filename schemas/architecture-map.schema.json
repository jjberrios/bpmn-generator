{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bpmn-reverse-engineer.local/schemas/architecture-map.schema.json",
  "title": "Mapa de arquitectura",
  "description": "Inventario técnico estructurado producido por source-code-analysis y complementado por repository-mapper.",
  "type": "object",
  "required": ["schema_version", "project_id", "languages", "frameworks", "build_files", "modules", "components", "entry_points", "integrations", "documentation", "unresolved"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "const": "1.0" },
    "project_id": { "type": "string" },
    "languages": { "type": "array", "items": { "type": "object", "required": ["name", "files"], "additionalProperties": false, "properties": { "name": { "type": "string" }, "files": { "type": "integer" }, "version_hint": { "type": "string" } } } },
    "frameworks": { "type": "array", "items": { "type": "object", "required": ["name", "evidence"], "additionalProperties": false, "properties": { "name": { "type": "string" }, "version": { "type": "string" }, "evidence": { "type": "string" } } } },
    "build_files": { "type": "array", "items": { "type": "string" } },
    "modules": { "type": "array", "items": { "type": "object", "required": ["name", "path"], "additionalProperties": false, "properties": { "name": { "type": "string" }, "path": { "type": "string" }, "packages": { "type": "array", "items": { "type": "string" } }, "dependencies": { "type": "array", "items": { "type": "string" } } } } },
    "components": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "kind", "class", "file", "line"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string" },
          "kind": { "enum": ["controller", "service", "repository", "client", "configuration", "entity", "exception", "handler", "other"] },
          "class": { "type": "string" },
          "package": { "type": "string" },
          "file": { "type": "string" },
          "line": { "type": "integer", "minimum": 1 },
          "annotations": { "type": "array", "items": { "type": "string" } },
          "extends": { "type": "string" },
          "implements": { "type": "array", "items": { "type": "string" } },
          "dependencies": { "type": "array", "items": { "type": "object", "required": ["name", "type"], "additionalProperties": false, "properties": { "name": { "type": "string" }, "type": { "type": "string" }, "resolved_component": { "type": ["string", "null"] } } } },
          "methods": { "type": "array", "items": { "type": "object", "required": ["name", "line_start", "line_end"], "additionalProperties": false, "properties": { "name": { "type": "string" }, "signature": { "type": "string" }, "line_start": { "type": "integer" }, "line_end": { "type": "integer" } } } }
        }
      }
    },
    "entry_points": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "kind", "class", "method", "file", "line"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string" },
          "kind": { "enum": ["rest", "scheduled", "listener", "main", "event"] },
          "http_method": { "type": "string" },
          "path": { "type": "string" },
          "class": { "type": "string" },
          "method": { "type": "string" },
          "file": { "type": "string" },
          "line": { "type": "integer", "minimum": 1 },
          "annotations": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "integrations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "kind", "mechanism", "class", "method", "file", "line"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string" },
          "kind": { "enum": ["http", "database", "messaging", "other"] },
          "mechanism": { "type": "string", "description": "RestTemplate, WebClient, Feign, JPA, JDBC, Kafka, etc." },
          "class": { "type": "string" },
          "method": { "type": "string" },
          "target": { "type": "string", "description": "URL, tabla, tópico o entidad cuando se pueda determinar estáticamente." },
          "operation": { "type": "string" },
          "file": { "type": "string" },
          "line": { "type": "integer", "minimum": 1 }
        }
      }
    },
    "documentation": { "type": "array", "items": { "type": "string" } },
    "unresolved": { "type": "array", "items": { "type": "object", "required": ["description"], "additionalProperties": false, "properties": { "description": { "type": "string" }, "file": { "type": "string" }, "line": { "type": "integer" } } } }
  }
}
